<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%-- Top bar of the public / user side of the website --%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RentTrack - Rent cameras, laptops, projectors and tools</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="site">

<header class="topbar">
    <a href="/" class="logo">Rent<span>Track</span></a>

    <nav>
        <a href="/" class="${current == 'home' ? 'active' : ''}">Browse</a>
        <c:if test="${not empty sessionScope.loggedUser}">
            <a href="/my-rentals" class="${current == 'myRentals' ? 'active' : ''}">My Rentals</a>
        </c:if>
    </nav>

    <div class="account">
        <c:choose>
            <c:when test="${empty sessionScope.loggedUser}">
                <a class="btn light small" href="/login">Login</a>
                <a class="btn small" href="/register">Sign up</a>
            </c:when>
            <c:otherwise>
                <span class="hello">Hi, <c:out value="${sessionScope.loggedUser.fullName}"/></span>
                <form method="post" action="/logout">
                    <button class="btn light small">Logout</button>
                </form>
            </c:otherwise>
        </c:choose>
    </div>
</header>

<main>
    <c:if test="${not empty message}">
        <div class="alert success"><c:out value="${message}"/></div>
    </c:if>
    <c:if test="${not empty error}">
        <div class="alert danger"><c:out value="${error}"/></div>
    </c:if>
