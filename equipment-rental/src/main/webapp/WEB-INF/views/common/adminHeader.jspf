<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%-- Side menu of the admin panel --%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RentTrack - Admin panel</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin">

<aside class="sidebar">
    <h1 class="logo">Rent<span>Track</span></h1>
    <p class="panel-name">Admin panel</p>
    <nav>
        <a href="/admin" class="${current == 'dashboard' ? 'active' : ''}">Dashboard</a>
        <a href="/admin/equipment" class="${current == 'equipment' ? 'active' : ''}">Equipment</a>
        <a href="/admin/rentals" class="${current == 'rentals' ? 'active' : ''}">Rentals</a>
        <a href="/admin/damage" class="${current == 'damage' ? 'active' : ''}">Damage Reports</a>
        <a href="/admin/users" class="${current == 'users' ? 'active' : ''}">Users</a>
    </nav>

    <div class="side-user">
        <p><c:out value="${sessionScope.loggedUser.fullName}"/></p>
        <form method="post" action="/logout">
            <button class="btn light small">Logout</button>
        </form>
    </div>
</aside>

<main>
    <c:if test="${not empty message}">
        <div class="alert success"><c:out value="${message}"/></div>
    </c:if>
    <c:if test="${not empty error}">
        <div class="alert danger"><c:out value="${error}"/></div>
    </c:if>
